# Copy to .env and set the key locally. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SPELLFIND_HOST=127.0.0.1
SPELLFIND_PORT=5000
SPELLFIND_DEBUG=false
SPELLFIND_MAX_QUERY_LENGTH=4000
# Experimental opt-in until human/model comparisons justify routine refinement.
SPELLFIND_ENABLE_REFINEMENT=false
# Relative paths resolve from the project directory, not the shell's cwd.
SPELLFIND_OUTPUT_DIR=output
SPELLFIND_PROMPT_PATH=api_prompt.txt
SPELLFIND_CATALOG_DIR=data/catalog
SPELLFIND_INGEST_DIR=data/ingestion
# Optional ingestion tools/weights must be provisioned before enabling.
SPELLFIND_INGEST_ENABLED=false
SPELLFIND_CATALOG_QUOTA_BYTES=536870912
SPELLFIND_INGEST_QUOTA_BYTES=2147483648
SPELLFIND_BACKUP_QUOTA_BYTES=2147483648
# Optional override; otherwise PATH and .tools/ffmpeg/ffmpeg.exe are checked.
# SPELLFIND_FFMPEG=.tools/ffmpeg/ffmpeg.exe
# Only required to rebuild private Hugging Face datasets:
HF_TOKEN=
